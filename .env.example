# =============================================================================
# Career Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=career_agent
DB_USERNAME=career_agent
DB_PASSWORD=career_agent

# --- Server ---
SERVER_PORT=8080

# --- JWT ---
# IMPORTANT: Change this in production! Must be at least 256 bits (32+ chars)
JWT_SECRET=change-me-in-production-this-is-a-placeholder-key-that-must-be-at-least-256-bits
JWT_EXPIRATION_MS=86400000

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Correlation-ID

# --- Email (IMAP) ---
MAIL_HOST=
MAIL_PORT=993
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Workflow ---
WORKFLOW_CRON=0 0 8 * * *
WORKFLOW_TIMEZONE=UTC

# --- LLM Rate Limiting ---
LLM_CALLS_PER_MINUTE=30
LLM_QUEUE_CAPACITY=500
LLM_CALL_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_INITIAL_RETRY_DELAY=2000

# --- MinIO Object Storage ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=career-agent-documents

# --- Portal Session Encryption ---
# IMPORTANT: Change this in production! Must be a 256-bit key (32 bytes, hex or base64 encoded)
PORTAL_ENCRYPTION_KEY=change-me-in-production-must-be-256-bit-key
